{
  "name": "smartflow",
  "version": "1.0.0",
  "main": "electron/main.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --port 8085",
    "build:web": "npx expo export -p web",
    "electron:start": "electron electron/main.js",
    "electron:package": "node scripts/build-desktop.js --dir",
    "electron:build": "node scripts/build-desktop.js --win --x64"
  },
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.3.12",
    "typescript": "^5.3.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0"
  },
  "private": true,
  "build": {
    "appId": "com.socialsched.app",
    "productName": "SocialSched",
    "icon": "assets/icon.ico",
    "directories": {
      "output": "dist-desktop"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ]
  }
}
